{
  "name": "icloud-price-comparison",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.14.0",
  "scripts": {
    "check:live": "node scripts/update-prices.mjs --dry-run",
    "update:data": "node scripts/update-prices.mjs",
    "test": "pnpm test:core && pnpm test:browsers",
    "test:core": "pnpm test:vendor && node --test test/auto-merge-official-actions.test.mjs test/daily-run-guard.test.mjs test/data-contract.test.mjs test/data-integrity.test.mjs test/parse-legacy-archive.test.mjs test/parse-prices.test.mjs test/import-apple-archives.test.mjs test/update-prices.test.mjs test/workflow.test.mjs",
    "test:data": "node --test test/data-integrity.test.mjs",
    "validate:snapshots": "node --test test/snapshot-deep-audit.test.mjs",
    "test:browsers": "node scripts/test-browsers.mjs",
    "test:ui": "node --test test/ui-smoke.test.mjs",
    "test:webkit": "node --test scripts/test-webkit.mjs",
    "test:vendor": "node scripts/verify-vendor.mjs"
  },
  "dependencies": {
    "cheerio": "1.1.2"
  },
  "devDependencies": {
    "chart.js": "4.4.7",
    "lucide": "0.468.0",
    "playwright": "1.62.1"
  }
}
